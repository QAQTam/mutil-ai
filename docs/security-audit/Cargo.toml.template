[package]
name = "mutil-ai-security-audit-poc"
version = "0.0.0"
edition = "2024"

[workspace]

[dependencies]
mutil-ai = { path = "../.." }
async-trait = "0.1"
reqwest = { version = "0.13", default-features = false, features = ["json", "rustls", "http2", "gzip", "query", "stream"] }
serde_json = "1"
tokio = { version = "1", features = ["macros", "rt-multi-thread", "net", "io-util", "time"] }

[[test]]
name = "poc"
path = "../../docs/security-audit/poc.rs"
